# Local development environment for Claude Code scraper
# Copy this to .env.local and fill in your Supabase URL

# Canonical site URL (used for metadata, canonical links, sitemaps, JSON-LD @ids)
# Set in Vercel project settings: https://vercel.com/dashboard → your project → Settings → Environment Variables
NEXT_PUBLIC_SITE_URL=https://www.joboye.com

# Supabase connection string (from Settings → Database → Connection string)
# Format: postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Dry-run mode: default true (preview only, no database writes)
# Set to 'false' to actually write to Supabase
# DRY_RUN=false

# Optional: output path for raw postings dump (default: /tmp/joboye-raw-postings.json)
# INGEST_OUT=/path/to/dump.json

# Google Analytics 4 Measurement ID (from GA4 property)
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G_XXXXXXXXXXXXX

# Optional. Enables the paid (LLM) path of /api/query/normalize for callers sending "Authorization: Bearer <value>". Unset = paid path off.
QUERY_NORMALIZE_SECRET=
