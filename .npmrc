# next-intl@^3.23.0's declared peer range doesn't include next@16 (this repo
# is on next@16.3.7). That makes a bare `npm install`/`npm ci` fail with
# ERESOLVE — confirmed locally tonight, and almost certainly why Vercel
# builds have been failing ("deployment not found" is what a failed/missing
# build looks like from the outside, not a literal missing-URL error).
# This has been broken since next-intl was added in 73847dc, pinned to
# next@16.3.7 from the start — not a regression from tonight's work.
#
# legacy-peer-deps unblocks the install the same way the local workaround
# did. Real fix is upgrading to next-intl@4.14.8 (supports next@16) —
# tracked separately, not done here to keep tonight's change minimal.
legacy-peer-deps=true
